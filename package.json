{
  "name": "web-capybara-escape",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "homepage": "https://github.com/Solvro/web-capybara-escape#readme",
  "bugs": {
    "url": "https://github.com/Solvro/web-capybara-escape/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solvro/web-capybara-escape.git"
  },
  "license": "MIT",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run start --prefix server\" \"npm run dev --prefix client\"",
    "export:levels": "npm run export:levels --prefix server",
    "export:levels:force": "npm run export:levels:force --prefix server",
    "format": "prettier --write client server",
    "format:check": "prettier --check client server",
    "prepare": "husky",
    "test": "npm run test:server",
    "test:server": "npm run test --prefix server"
  },
  "lint-staged": {
    "*": "prettier -w --ignore-unknown"
  },
  "overrides": {
    "glob": "^13.0.6"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@solvro/config": "^2.3.4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0"
  }
}
